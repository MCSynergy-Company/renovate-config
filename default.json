{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":pinDigests"
  ],
  "automerge": false,
  "timezone": "Europe/Amsterdam",
  "minimumReleaseAge": "3 days",
  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": null,
    "schedule": ["at any time"],
    "groupName": "Security Fixes",
    "addLabels": ["security"]
  },
  "nuget": {
    "registryUrls": [
      "https://api.nuget.org/v3/index.json",
      "https://nuget.riderapp.nl/v3/index.json"
    ]
  },
  "packageRules": [
    {
      "description": "Bundle stable minor and patch updates into a single weekly PR to reduce pull request noise.",
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0/",
      "schedule": ["before 8am on monday"],
      "groupName": "Weekly Non-Major Updates",
      "groupSlug": "weekly-minor-patch"
    },
    {
      "description": "Isolate internal RideR NuGet packages into a dedicated group so team updates aren't mixed with public ecosystem noise.",
      "matchManagers": ["nuget"],
      "matchPackagePatterns": ["^MCSynergy\\.RideR"],
      "groupName": "Internal RideR Updates",
      "groupSlug": "internal-rider-deps"
    },
    {
      "description": "Force untagged or 'latest' Docker images to resolve to a precise semantic version tag whenever pinning digests.",
      "matchDatasources": ["docker"],
      "matchCurrentVersion": "/^latest$/",
      "pinDigests": true
    }
  ]
}